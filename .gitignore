# Dependencies
node_modules/

# Build output — the Pages workflow publishes from a local build, not from git
dist/
upload/

# Panda CSS codegen (regenerated by `npm run codegen`)
styled-system/
**/src/panda.css

# Licensed commercial fonts — DO NOT COMMIT.
# Galano Grotesque Alt (René Bieder) is a paid face. This repo is public, so shipping
# the binaries would breach its license. The Haven stylesheet and dev.html both load
# the same faces from the public static.rdc.moveaws.com CDN instead, so nothing is
# lost visually. If you clone this and want local copies, drop them in
# agent-web/public/haven/fonts/ — they stay ignored.
*.otf
*.ttf
*.woff
*.woff2

# Env / secrets
.env
.env.*
!.env.example

# npm registry config — points at internal Artifactory
.npmrc

# Claude Code per-machine state. Accumulates local absolute paths and granted tool
# permissions, so it is one developer's setup, not the project's. Everything shared
# — .claude/skills/, and .claude/settings.json if we add one — stays tracked.
.claude/settings.local.json

# macOS
.DS_Store
