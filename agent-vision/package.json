{
  "name": "agent-vision-shell",
  "type": "module",
  "version": "1.0.0",
  "description": "Agent Vision — RealAssist+ content orchestration prototype shell for Design AI Infrastructure Studio (duplicated from agent-web)",
  "scripts": {
    "dev": "panda codegen && panda cssgen --outfile src/panda.css && vite",
    "build": "panda codegen && panda cssgen --outfile src/panda.css && vite build",
    "preview": "vite preview",
    "codegen": "panda codegen && panda cssgen --outfile src/panda.css",
    "bundle": "npm run build && node scripts/bundle-single-file.mjs",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@rdc-npm/rdc-ui-v4": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@pandacss/dev": "latest",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.0",
    "vite-tsconfig-paths": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.7",
    "fast-uri": "^3.1.4",
    "body-parser": "^2.3.0"
  }
}
